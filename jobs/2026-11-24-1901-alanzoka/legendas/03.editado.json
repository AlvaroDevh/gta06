{"blocos": [{"f": 1, "texto": "Mano, eu atropelei,", "pos": 0.6}, {"f": 1, "texto": "eu atropelei uma", "pos": 0.6}, {"f": 1, "texto": "galinha. \"Ah, mano, eu", "pos": 0.6}, {"f": 1, "texto": "ganhei negócio de psicopata\". Eu,", "pos": 0.6}, {"f": 1, "texto": "cara, nem vi", "pos": 0.6}, {"f": 1, "texto": "a galinha, porque,", "pos": 0.6}, {"f": 1, "texto": "primeiramente,", "pos": 0.6}, {"f": 1, "texto": "por que que tinha uma galinha aqui,", "pos": 0.6}, {"f": 1, "texto": "né? Vou falar a verdade,", "pos": 0.6}, {"f": 1, "texto": "no meio da rua!", "pos": 0.6}, {"f": 1, "texto": "Botaram um cone na cabeça", "pos": 0.6}, {"f": 1, "texto": "do cavalo, velho!", "pos": 0.6}, {"f": 1, "texto": "Dá pra escanear isso daí?", "pos": 0.6}, {"f": 1, "texto": "Parece que se eu der", "pos": 0.6}, {"f": 1, "texto": "um tiro no cone", "pos": 0.6}, {"f": 1, "texto": "pra tirar e ajudar", "pos": 0.6}, {"f": 1, "texto": "o cavalo, eu ganho", "pos": 0.6}, {"f": 1, "texto": "um prêmio.", "pos": 0.6}, {"f": 1, "texto": "Pronto,", "pos": 0.6}, {"f": 1, "texto": "ajudei o cavalo, mano!", "pos": 0.6}]}