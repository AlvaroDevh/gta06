{"blocos": [{"f": 1, "texto": "Puta cortando", "pos": 0.6}, {"f": 1, "texto": "de giro, velho, tá", "pos": 0.6}, {"f": 1, "texto": "me estressando!", "pos": 0.6}, {"f": 1, "texto": "Às vezes é de missão...", "pos": 0.6}, {"f": 1, "texto": "Mano, será que é de missão, cara?", "pos": 0.6}, {"f": 1, "texto": "E eu tô...", "pos": 0.6}, {"f": 1, "texto": "Não, não!", "pos": 0.6}, {"f": 1, "texto": "Olha, ele mandou eu", "pos": 0.6}, {"f": 1, "texto": "pegar mais peru.", "pos": 0.6}, {"f": 1, "texto": "Mano, ainda bem", "pos": 0.6}, {"f": 1, "texto": "que não tinha alarme, velho! Eu só", "pos": 0.6}, {"f": 1, "texto": "apertei o botão", "pos": 0.6}, {"f": 1, "texto": "de arrombar sem", "pos": 0.6}, {"f": 1, "texto": "querer. Mano,", "pos": 0.6}, {"f": 1, "texto": "tô achando que isso daí é uma missão, velho.", "pos": 0.6}, {"f": 1, "texto": "O cara dando cavalo de pau", "pos": 0.6}, {"f": 1, "texto": "é um bagulho secundário, eu não sei.", "pos": 0.6}]}