{"blocos": [{"f": 1, "texto": "Oxi, cara,", "de": 1.51, "ate": 2.07, "pos": 0.6}, {"f": 1, "texto": "minha moto,", "de": 2.07, "ate": 2.55, "pos": 0.6}, {"f": 2, "texto": "ué, minha", "de": 3.54, "ate": 4.36, "pos": 0.6}, {"f": 2, "texto": "moto foi parar lá dentro,", "pos": 0.6}, {"f": 2, "texto": "Chat, eu parei ali", "de": 13.71, "ate": 14.51, "pos": 0.6}, {"f": 2, "texto": "dentro?", "de": 14.51, "ate": 14.89, "pos": 0.6}, {"f": 1, "texto": "eu não parei ali", "de": 18.72, "ate": 19.38, "pos": 0.6}, {"f": 1, "texto": "dentro, eu parei", "de": 19.38, "ate": 20.16, "pos": 0.6}, {"f": 1, "texto": "fora, pô! Tô louco?", "de": 20.16, "ate": 21.87, "pos": 0.6}, {"f": 1, "texto": "Meu", "de": 21.87, "ate": 22.37, "pos": 0.6}, {"f": 1, "texto": "Deus, tô com amnésia, mano,", "pos": 0.6}, {"f": 1, "texto": "cara, preciso fazer", "de": 28.01, "ate": 28.55, "pos": 0.6}, {"f": 1, "texto": "carinho em cachorro,", "de": 28.55, "ate": 29.17, "pos": 0.6}, {"f": 1, "texto": "porque, mano, esse", "de": 29.37, "ate": 29.97, "pos": 0.6}, {"f": 1, "texto": "cachorro não tá com cara de quem", "pos": 0.6}, {"f": 1, "texto": "vai querer um carinho, não,", "pos": 0.6}, {"f": 1, "texto": "com todo respeito", "de": 31.67, "ate": 32.33, "pos": 0.6}, {"f": 1, "texto": "Aqui, filho, tô,", "de": 34.54, "ate": 35.36, "pos": 0.6}, {"f": 1, "texto": "desculpa, cachorro", "de": 39.39, "ate": 40.47, "pos": 0.6}, {"f": 1, "texto": "aqui, mano, eu não", "de": 40.47, "ate": 41.13, "pos": 0.6}, {"f": 1, "texto": "resisti.", "de": 41.13, "ate": 41.59, "pos": 0.6}]}