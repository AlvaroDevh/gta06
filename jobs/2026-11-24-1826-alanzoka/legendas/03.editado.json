{"blocos": [{"f": 1, "texto": "Não é possível que eu vou tomar", "pos": 0.46}, {"f": 1, "texto": "um tiro aqui, eu", "pos": 0.46}, {"f": 1, "texto": "tô com medo, mano!", "pos": 0.46}, {"f": 1, "texto": "Tá mina no chão, Jesus! Tá,", "pos": 0.46}, {"f": 1, "texto": "então eu não vou tomar tiro, eu vou tomar...", "pos": 0.46}, {"f": 1, "texto": "Meu Deus, ai!", "pos": 0.46}, {"f": 1, "texto": "Caramba, como que não tomei dano?", "pos": 0.46}, {"f": 1, "texto": "Ah, mina não letal!", "pos": 0.46}, {"f": 1, "texto": "Puta que pariu, mano,", "pos": 0.46}, {"f": 1, "texto": "que que é isso?", "pos": 0.46}, {"f": 1, "texto": "Gente, que perigo!", "pos": 0.46}, {"f": 1, "texto": "Pega nóis, seu comédia!", "pos": 0.46}, {"f": 1, "texto": "Mano, o drone", "pos": 0.46}, {"f": 1, "texto": "é implodível!", "pos": 0.46}]}