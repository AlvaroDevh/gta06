{"blocos": [{"f": 1, "texto": "Por favor, não morram, mano!", "pos": 0.46}, {"f": 1, "texto": "Puta que pariu, o dinheiro!", "pos": 0.46}, {"f": 1, "texto": "Pega as bolsas, pega", "pos": 0.46}, {"f": 1, "texto": "as bolsas, pega", "pos": 0.46}, {"f": 1, "texto": "as bolsas!", "pos": 0.46}, {"f": 1, "texto": "Eu não", "pos": 0.46}, {"f": 1, "texto": "sou demônio, nossa!", "pos": 0.46}, {"f": 1, "texto": "Na moral, bota", "pos": 0.46}, {"f": 1, "texto": "a capa, né?", "pos": 0.46}, {"f": 1, "texto": "Eu não sei se influencia alguma", "pos": 0.46}, {"f": 1, "texto": "coisa. Mas errei", "pos": 0.46}, {"f": 1, "texto": "o caminho, calma.", "pos": 0.46}, {"f": 1, "texto": "Caralho, chat, esse", "pos": 0.46}, {"f": 1, "texto": "aqui foi o meu maior dinheiro", "pos": 0.46}, {"f": 1, "texto": "que eu já ganhei,", "pos": 0.46}, {"f": 1, "texto": "mano, 46 mil!", "pos": 0.46}, {"f": 1, "texto": "Quase 100 mil reais,", "pos": 0.46}, {"f": 1, "texto": "mano, faltou só 50 mil!", "pos": 0.46}]}