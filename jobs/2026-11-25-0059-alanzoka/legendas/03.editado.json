{"blocos": [{"f": 1, "texto": "Cara, que eu não achei que o cara", "pos": 0.76}, {"f": 1, "texto": "tinha o necessário", "de": 6.11, "ate": 8.0, "pos": 0.6}, {"f": 1, "texto": "pra dar uma bala", "de": 8.0, "ate": 8.62, "pos": 0.6}, {"f": 1, "texto": "nela, pô. Achei que o cara", "pos": 0.6}, {"f": 1, "texto": "ia falar \"não\".", "de": 9.76, "ate": 10.6, "pos": 0.6}, {"f": 1, "texto": "Nossa, bate na polícia ainda", "pos": 0.6}, {"f": 1, "texto": "pra melhorar minha vida.", "pos": 0.6}, {"f": 1, "texto": "Eu achei que o cara ia querer", "pos": 0.6}, {"f": 1, "texto": "conversar, sabe?", "de": 19.91, "ate": 21.37, "pos": 0.6}, {"f": 4, "texto": "O cara tinha acabado", "de": 27.52, "ate": 28.22, "pos": 0.6}, {"f": 4, "texto": "de matar o outro.", "pos": 0.6}, {"f": 2, "texto": "Não, mas o outro é o outro.", "pos": 0.6}, {"f": 2, "texto": "Cara,", "de": 32.27, "ate": 32.59, "pos": 0.6}, {"f": 3, "texto": "eu tenho uma escolha.", "pos": 0.6}, {"f": 3, "texto": "Eu mando a Shayna", "de": 35.21, "ate": 36.79, "pos": 0.6}, {"f": 3, "texto": "deixar pra lá", "de": 36.79, "ate": 37.53, "pos": 0.6}, {"f": 2, "texto": "ou baleio o cara.", "de": 37.53, "ate": 38.53, "pos": 0.6}]}