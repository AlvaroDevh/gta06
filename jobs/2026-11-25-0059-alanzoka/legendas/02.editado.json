{"blocos": [{"f": 2, "texto": "É, agora?", "de": 1.61, "ate": 2.47, "pos": 0.6}, {"f": 2, "texto": "Nossa, essa missão", "de": 2.83, "ate": 3.53, "pos": 0.6}, {"f": 2, "texto": "é timer,", "de": 3.53, "ate": 4.01, "pos": 0.6}, {"f": 2, "texto": "essa missão tem", "de": 4.89, "ate": 5.47, "pos": 0.6}, {"f": 2, "texto": "o timer gamer, chat.", "de": 5.47, "ate": 6.55, "pos": 0.6}, {"f": 1, "texto": "é foda, mano, tem", "de": 17.12, "ate": 18.22, "pos": 0.6}, {"f": 1, "texto": "cheiro de golpe.", "de": 18.22, "ate": 19.12, "pos": 0.6}, {"f": 1, "texto": "Meu Deus, eu", "de": 19.95, "ate": 20.61, "pos": 0.6}, {"f": 1, "texto": "tô foragida, né?", "de": 20.61, "ate": 21.61, "pos": 0.6}, {"f": 1, "texto": "Não, relaxa, pô,", "de": 21.81, "ate": 22.91, "pos": 0.6}, {"f": 1, "texto": "é onde os policiais", "de": 23.33, "ate": 24.03, "pos": 0.6}, {"f": 1, "texto": "ao menos esperam", "de": 24.03, "ate": 24.73, "pos": 0.6}, {"f": 1, "texto": "que eu esteja, mano,", "de": 24.73, "ate": 25.47, "pos": 0.6}, {"f": 1, "texto": "é na prisão. Pensa", "de": 25.51, "ate": 26.45, "pos": 0.6}, {"f": 1, "texto": "nisso. Cara,", "de": 26.45, "ate": 27.15, "pos": 0.6}, {"f": 1, "texto": "é assim que o motoqueiro morre,", "pos": 0.6}, {"f": 1, "texto": "né, mano, olha os lugares que eu", "pos": 0.6}, {"f": 1, "texto": "quero passar, velho.", "de": 35.42, "ate": 36.46, "pos": 0.6}, {"f": 1, "texto": "Porra, tem", "de": 36.54, "ate": 37.08, "pos": 0.6}, {"f": 1, "texto": "que prestar atenção,", "de": 37.08, "ate": 37.78, "pos": 0.6}, {"f": 1, "texto": "tá, pessoal, que anda de moto,", "pos": 0.6}, {"f": 1, "texto": "toma cuidado, velho,", "de": 38.96, "ate": 39.9, "pos": 0.6}, {"f": 1, "texto": "toma cuidado, mano,", "de": 40.19, "ate": 41.11, "pos": 0.6}, {"f": 1, "texto": "tá? Toma cuidado.", "de": 41.92, "ate": 43.02, "pos": 0.6}, {"f": 1, "texto": "Tem que, pô, vai", "de": 43.81, "ate": 44.63, "pos": 0.6}, {"f": 1, "texto": "na tranquilidade,", "de": 44.63, "ate": 45.39, "pos": 0.6}, {"f": 1, "texto": "não tenta passar", "de": 45.65, "ate": 46.19, "pos": 0.6}, {"f": 1, "texto": "em qualquer buraco,", "de": 46.19, "ate": 46.83, "pos": 0.6}, {"f": 1, "texto": "é perigoso, mano.", "de": 46.87, "ate": 47.71, "pos": 0.6}]}