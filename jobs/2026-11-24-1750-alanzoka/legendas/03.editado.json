{"blocos": [{"f": 1, "texto": "É louco,", "pos": 0.46}, {"f": 1, "texto": "ai, ai, ai, mano,", "pos": 0.46}, {"f": 1, "texto": "Eu não bateria o carro", "pos": 0.46}, {"f": 1, "texto": "se o cara não tivesse", "pos": 0.46}, {"f": 1, "texto": "andando com a porra", "pos": 0.46}, {"f": 1, "texto": "de uma caçamba atrás", "pos": 0.46}, {"f": 1, "texto": "do veículo, né?", "pos": 0.46}, {"f": 1, "texto": "Vamos falar a verdade.", "pos": 0.46}, {"f": 1, "texto": "Meu carro tá com", "pos": 0.46}, {"f": 1, "texto": "a cambagem nas rodas,", "pos": 0.46}, {"f": 1, "texto": "já de tão batido.", "pos": 0.46}, {"f": 1, "texto": "Meu carro não vira, pô!", "pos": 0.46}, {"f": 1, "texto": "Ele literalmente não vira,", "pos": 0.46}, {"f": 1, "texto": "porque tava na grama.", "pos": 0.46}, {"f": 1, "texto": "O importante é chegar, mano.", "pos": 0.46}, {"f": 1, "texto": "Ninguém joga GTA", "pos": 0.46}, {"f": 1, "texto": "andando certo, eu não", "pos": 0.46}, {"f": 1, "texto": "entendi por que começaram", "pos": 0.46}, {"f": 1, "texto": "a reclamar da minha dirigibilidade.", "pos": 0.46}, {"f": 1, "texto": "Ninguém joga GTA", "pos": 0.46}, {"f": 1, "texto": "sem bater, fala sério!", "pos": 0.46}, {"f": 1, "texto": "\"Ai, eu paro", "pos": 0.46}, {"f": 1, "texto": "no farol vermelho\",", "pos": 0.46}, {"f": 1, "texto": "para sim, viu?", "pos": 0.46}, {"f": 1, "texto": "Deve parar mesmo.", "pos": 0.46}]}