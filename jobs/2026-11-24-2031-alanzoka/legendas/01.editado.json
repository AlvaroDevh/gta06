{"blocos": [{"f": 1, "texto": "Esse aqui eu tenho", "pos": 0.6}, {"f": 1, "texto": "que chegar sem bater, mano.", "pos": 0.6}, {"f": 1, "texto": "Caralho, que", "pos": 0.6}, {"f": 1, "texto": "susto!", "pos": 0.6}, {"f": 1, "texto": "Meu Deus,", "pos": 0.6}, {"f": 1, "texto": "caralho,", "pos": 0.6}, {"f": 1, "texto": "susto da porra, velho!", "pos": 0.6}, {"f": 1, "texto": "Meu Deus!", "pos": 0.6}, {"f": 1, "texto": "Aí coçou meu joelho.", "pos": 0.6}, {"f": 1, "texto": "Vai, irmão, mete", "pos": 0.6}, {"f": 1, "texto": "o pé! Não", "pos": 0.6}, {"f": 1, "texto": "bati, não bati, não", "pos": 0.6}, {"f": 1, "texto": "bati! Calma,", "pos": 0.6}, {"f": 1, "texto": "calma, vou tentar derrubar ele.", "pos": 0.6}, {"f": 1, "texto": "Cara,", "pos": 0.6}, {"f": 1, "texto": "ele ficou vivo,", "pos": 0.6}, {"f": 1, "texto": "pense nisso. É,", "pos": 0.6}, {"f": 1, "texto": "eu tive que fazer", "pos": 0.6}, {"f": 1, "texto": "isso pra derrubar ele, ué.", "pos": 0.6}]}