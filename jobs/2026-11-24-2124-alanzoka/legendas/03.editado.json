{"blocos": [{"f": 1, "texto": "Infelizmente não vou", "pos": 0.46}, {"f": 1, "texto": "mais roubar banco", "pos": 0.46}, {"f": 1, "texto": "não, mano. Ah,", "pos": 0.46}, {"f": 1, "texto": "é, mano, eu tinha", "pos": 0.46}, {"f": 1, "texto": "que ir de moto pra fazer a fuga,", "pos": 0.46}, {"f": 1, "texto": "né? Esqueci que eu", "pos": 0.46}, {"f": 1, "texto": "peguei uma moto agora.", "pos": 0.46}, {"f": 1, "texto": "Completamente. Olha", "pos": 0.46}, {"f": 1, "texto": "o Gingin, vendi", "pos": 0.46}, {"f": 1, "texto": "tesouro da Urca", "pos": 0.46}, {"f": 1, "texto": "das 5 torres.", "pos": 0.46}, {"f": 1, "texto": "Caralho, 25 mil?", "pos": 0.46}, {"f": 1, "texto": "Que isso, gente,", "pos": 0.46}, {"f": 1, "texto": "tô ganhando dinheiro, mano,", "pos": 0.46}, {"f": 1, "texto": "não sei de onde", "pos": 0.46}, {"f": 1, "texto": "tá vindo dinheiro,", "pos": 0.46}, {"f": 1, "texto": "mas tá vindo! Obrigado.", "pos": 0.46}]}