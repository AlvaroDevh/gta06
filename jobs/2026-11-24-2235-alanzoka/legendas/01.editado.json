{"blocos": [{"f": 2, "texto": "Nossa, que hospital", "de": 41.89, "ate": 42.61, "pos": 0.76}, {"f": 2, "texto": "bom, hein, mano.", "de": 42.61, "ate": 43.51, "pos": 0.76}, {"f": 1, "texto": "arma aí, dá", "de": 50.09, "ate": 50.65, "pos": 0.6}, {"f": 1, "texto": "pra mim, ela", "de": 50.65, "ate": 51.39, "pos": 0.6}, {"f": 1, "texto": "é rara.", "de": 51.39, "ate": 51.89, "pos": 0.6}, {"f": 1, "texto": "quer dizer", "de": 52.43, "ate": 52.65, "pos": 0.6}, {"f": 4, "texto": "Ah, nice, é isso aí", "pos": 0.6}, {"f": 1, "texto": "Lair de 350", "de": 59.47, "ate": 60.39, "pos": 0.6}, {"f": 1, "texto": "do caçador", "de": 60.39, "ate": 61.39, "pos": 0.6}, {"f": 1, "texto": "Ó, ganhei anjinho!", "de": 62.37, "ate": 63.75, "pos": 0.6}, {"f": 1, "texto": "Mano, eu quero saber", "de": 64.85, "ate": 65.69, "pos": 0.6}, {"f": 1, "texto": "uma coisa, desce", "de": 65.69, "ate": 66.81, "pos": 0.6}, {"f": 1, "texto": "o bagulho que subiu,", "de": 66.81, "ate": 67.69, "pos": 0.6}, {"f": 1, "texto": "meu ou não?", "de": 67.83, "ate": 68.17, "pos": 0.6}, {"f": 1, "texto": "Ou pra sempre vou", "de": 69.49, "ate": 70.35, "pos": 0.6}, {"f": 1, "texto": "ser profissional,", "de": 70.35, "ate": 70.99, "pos": 0.6}, {"f": 1, "texto": "mano? Não é possível, eu nunca mais vou", "pos": 0.6}, {"f": 1, "texto": "voltar a ser... Calma,", "de": 72.37, "ate": 73.65, "pos": 0.6}, {"f": 1, "texto": "ele voltou já!", "de": 73.91, "ate": 74.61, "pos": 0.6}, {"f": 1, "texto": "Voltou!", "de": 76.47, "ate": 76.83, "pos": 0.6}, {"f": 1, "texto": "Voltou! Eu falei e", "pos": 0.6}, {"f": 1, "texto": "nem percebi, voltou", "de": 78.65, "ate": 79.73, "pos": 0.6}, {"f": 1, "texto": "já.", "de": 79.73, "ate": 79.97, "pos": 0.6}, {"f": 1, "texto": "Relaxa, relaxa", "de": 81.06, "ate": 82.22, "pos": 0.6}, {"f": 1, "texto": "Voltou.", "de": 82.22, "ate": 82.76, "pos": 0.6}]}