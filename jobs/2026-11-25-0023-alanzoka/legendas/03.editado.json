{"blocos": [{"f": 1, "texto": "Ele força os outros", "de": 1.29, "ate": 2.39, "pos": 0.6}, {"f": 1, "texto": "a saírem da frente,", "de": 2.39, "ate": 3.21, "pos": 0.6}, {"f": 1, "texto": "já você vai", "de": 3.31, "ate": 3.87, "pos": 0.46}, {"f": 1, "texto": "lá e arranca, não,", "de": 3.87, "ate": 4.81, "pos": 0.46}, {"f": 1, "texto": "não, não, os caras", "de": 5.01, "ate": 6.07, "pos": 0.46}, {"f": 1, "texto": "entram na minha frente", "pos": 0.46}, {"f": 1, "texto": "de propósito!", "de": 6.97, "ate": 7.71, "pos": 0.46}, {"f": 1, "texto": "Meu Deus, tá", "de": 9.83, "ate": 10.37, "pos": 0.46}, {"f": 1, "texto": "acabando a gasolina", "de": 10.37, "ate": 10.99, "pos": 0.46}, {"f": 1, "texto": "no carro, mano!", "de": 10.99, "ate": 11.61, "pos": 0.46}, {"f": 2, "texto": "Você viu?", "de": 13.33, "ate": 13.77, "pos": 0.46}, {"f": 2, "texto": "Comigo nunca acabou", "de": 13.95, "ate": 14.81, "pos": 0.46}, {"f": 2, "texto": "a gasolina, mano", "de": 14.81, "ate": 15.67, "pos": 0.46}, {"f": 2, "texto": "Cara,", "de": 15.67, "ate": 16.19, "pos": 0.46}, {"f": 1, "texto": "é ele que tá dirigindo ainda,", "pos": 0.46}, {"f": 1, "texto": "como é que eu cancelo ele", "pos": 0.46}, {"f": 1, "texto": "de dirigir?", "de": 27.71, "ate": 28.43, "pos": 0.46}, {"f": 1, "texto": "Quer dizer, só eu que tô dirigindo", "pos": 0.46}, {"f": 2, "texto": "agora. Viu", "de": 31.69, "ate": 32.57, "pos": 0.46}, {"f": 2, "texto": "como eu não bato", "de": 35.05, "ate": 35.73, "pos": 0.46}, {"f": 2, "texto": "também, ó?", "de": 35.73, "ate": 36.25, "pos": 0.46}, {"f": 2, "texto": "Aí, ó, não bato", "de": 41.31, "ate": 42.09, "pos": 0.46}, {"f": 2, "texto": "não. É", "de": 42.09, "ate": 42.81, "pos": 0.46}, {"f": 2, "texto": "ele que tá dirigindo", "de": 55.37, "ate": 56.47, "pos": 0.46}, {"f": 2, "texto": "porque eu tô", "de": 56.47, "ate": 57.11, "pos": 0.46}, {"f": 2, "texto": "com a Lucia, né? Acabei lembrando", "pos": 0.46}, {"f": 2, "texto": "esse detalhe logo", "de": 58.27, "ate": 59.01