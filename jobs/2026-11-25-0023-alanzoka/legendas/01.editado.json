{"blocos": [{"f": 4, "texto": "Liga pra polícia, mano!", "pos": 0.76}, {"f": 3, "texto": "vai chegar e vai", "de": 26.2, "ate": 27.02, "pos": 0.46}, {"f": 3, "texto": "dar uma só nele.", "de": 27.02, "ate": 27.86, "pos": 0.46}, {"f": 2, "texto": "Nice!", "de": 37.29, "ate": 37.69, "pos": 0.46}, {"f": 2, "texto": "Eita, porra, tomou", "de": 38.67, "ate": 39.63, "pos": 0.46}, {"f": 2, "texto": "uma só!", "de": 39.63, "ate": 39.95, "pos": 0.46}, {"f": 2, "texto": "Tomou duas!", "de": 40.95, "ate": 41.67, "pos": 0.46}, {"f": 4, "texto": "Caralho, mano,", "de": 45.18, "ate": 46.22, "pos": 0.46}, {"f": 4, "texto": "obrigado, bebê!", "pos": 0.46}, {"f": 1, "texto": "Ela fez dois tiros", "de": 61.29, "ate": 62.41, "pos": 0.46}, {"f": 1, "texto": "nele? Eu não entendi. Acho que minha arma", "pos": 0.46}, {"f": 1, "texto": "tá com silenciador.", "de": 63.51, "ate": 64.37, "pos": 0.46}, {"f": 1, "texto": "Daí não fez barulho", "de": 64.37, "ate": 65.75, "pos": 0.46}, {"f": 1, "texto": "direito.", "de": 65.75, "ate": 65.95, "pos": 0.46}]}