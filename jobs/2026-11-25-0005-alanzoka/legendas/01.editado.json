{"blocos": [{"f": 1, "texto": "Quem que falou Hank's Waffles?", "pos": 0.6}, {"f": 1, "texto": "Alguém falou Hank's", "de": 1.64, "ate": 2.38, "pos": 0.6}, {"f": 1, "texto": "Waffles, em algum", "de": 2.38, "ate": 3.04, "pos": 0.6}, {"f": 1, "texto": "lugar tava escrito,", "de": 3.04, "ate": 3.8, "pos": 0.6}, {"f": 1, "texto": "era na foto?", "de": 3.9, "ate": 4.62, "pos": 0.6}, {"f": 1, "texto": "Cara, mano, chat, eu", "de": 9.07, "ate": 10.47, "pos": 0.6}, {"f": 1, "texto": "achei a segundo", "de": 10.47, "ate": 11.49, "pos": 0.6}, {"f": 1, "texto": "lugar, é aqui", "de": 11.49, "ate": 12.19, "pos": 0.6}, {"f": 1, "texto": "pra caralho,", "de": 12.19, "ate": 12.73, "pos": 0.6}, {"f": 1, "texto": "é aqui pra caralho!", "de": 13.39, "ate": 14.09, "pos": 0.6}, {"f": 1, "texto": "é impossível não", "de": 14.15, "ate": 14.71, "pos": 0.6}, {"f": 1, "texto": "ser.", "de": 14.71, "ate": 14.91, "pos": 0.6}, {"f": 1, "texto": "\"Fotos macabras.\" Cara,", "de": 19.85, "ate": 21.25, "pos": 0.6}, {"f": 1, "texto": "tô com vergonha,", "de": 28.46, "ate": 28.96, "pos": 0.6}, {"f": 1, "texto": "porque parece que eu olhei, eu fui", "pos": 0.6}, {"f": 1, "texto": "direto, mano, gente,", "de": 29.86, "ate": 30.9, "pos": 0.6}, {"f": 1, "texto": "eu juro pra vocês", "de": 31.02, "ate": 31.56, "pos": 0.6}, {"f": 1, "texto": "que eu não olhei", "de": 31.56, "ate": 32.22, "pos": 0.6}, {"f": 1, "texto": "onde tá os lugares,", "de": 32.22, "ate": 33.0, "pos": 0.6}, {"f": 1, "texto": "tá?", "de": 33.18, "ate": 33.2, "pos": 0.6}, {"f": 1, "texto": "Cara, é que, mano,", "de": 33.87, "ate": 34.57, "pos": 0.6}, {"f": 1, "texto": "foi o... é que era", "pos": 0.6}, {"f": 1, "texto": "o único lugar", "de": 35.45, "ate": 36.01, "pos": 0.6}, {"f": 1, "texto": "que parecia, cara,", "de": 36.01, "ate": 36.79, "pos": 0.6}, {"f": 1, "texto": "é tipo,", "de": 36.93, "ate": 37.31, "pos": 0.6}, {"f": 1, "texto": "era literalmente o único lugar", "pos": 0.6}, {"f": 1, "texto": "que parecia, mano", "de": 39.