{"blocos": [{"f": 1, "texto": "Imagina, velho.", "de": 2.28, "ate": 3.24, "pos": 0.76}, {"f": 1, "texto": "Se Deus quiser,", "de": 6.03, "ate": 6.77, "pos": 0.76}, {"f": 1, "texto": "cadê?", "de": 6.97, "ate": 7.23, "pos": 0.76}, {"f": 1, "texto": "Ué,", "de": 8.53, "ate": 8.93, "pos": 0.76}, {"f": 1, "texto": "é?", "de": 9.57, "ate": 9.73, "pos": 0.76}, {"f": 1, "texto": "Mano, o cara não", "de": 10.44, "ate": 11.52, "pos": 0.76}, {"f": 1, "texto": "vai entender nada", "de": 11.52, "ate": 12.76, "pos": 0.76}, {"f": 1, "texto": "quando eu chegar", "de": 12.76, "ate": 13.48, "pos": 0.76}, {"f": 1, "texto": "e as defesas dele,", "de": 13.48, "ate": 14.56, "pos": 0.76}, {"f": 1, "texto": "ó. Vamos", "de": 14.66, "ate": 15.52, "pos": 0.76}, {"f": 3, "texto": "ver se as defesas", "de": 20.5, "ate": 22.85, "pos": 0.76}, {"f": 3, "texto": "dele é boa. É", "de": 22.85, "ate": 23.95, "pos": 0.76}, {"f": 4, "texto": "um", "de": 25.31, "ate": 28.35, "pos": 0.76}, {"f": 1, "texto": "jeito de entrar", "de": 30.63, "ate": 31.29, "pos": 0.76}, {"f": 1, "texto": "no bunker.", "de": 31.29, "ate": 31.87, "pos": 0.76}, {"f": 5, "texto": "Ai", "de": 39.1, "ate": 39.54, "pos": 0.76}, {"f": 2, "texto": "meu Deus, eu parei no pior lugar", "pos": 0.6}, {"f": 2, "texto": "possível. Cara,", "de": 42.74, "ate": 43.62, "pos": 0.6}, {"f": 1, "texto": "a bomba me levou", "de": 51.98, "ate": 52.7, "pos": 0.76}, {"f": 1, "texto": "pra hélice de helicóptero,", "pos": 0.76}, {"f": 1, "texto": "quais as chances, mano, na moral?", "pos": 0.6}, {"f": 1, "texto": "A bomba literalmente", "de": 55.12, "ate": 56.89, "pos": 0.6}, {"f": 1, "texto": "me explodiu", "de": 56.89, "ate": 58.31, "pos": 0.6}, {"f": 1, "texto": "pra hélice", "de": 58.31, "ate": 59.05, "pos": 0.6}, {"f": 1, "texto": "de helicóptero!", "de": 59.05, "ate": 59.79, "pos": 0.6}]}