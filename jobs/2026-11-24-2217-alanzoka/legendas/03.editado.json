{"blocos": [{"f": 1, "texto": "Será que ela tá seguindo meu GPS, mano?", "pos": 0.6}, {"f": 1, "texto": "Chego.", "de": 15.66, "ate": 16.02, "pos": 0.6}, {"f": 1, "texto": "Não, mas calma", "de": 17.12, "ate": 17.88, "pos": 0.6}, {"f": 1, "texto": "que eu não parei", "de": 17.88, "ate": 18.58, "pos": 0.6}, {"f": 1, "texto": "ainda, eu tô", "de": 18.58, "ate": 19.18, "pos": 0.6}, {"f": 1, "texto": "quilômetro?", "de": 21.69, "ate": 22.55, "pos": 0.6}, {"f": 1, "texto": "um quilômetro.", "de": 22.65, "ate": 23.33, "pos": 0.6}, {"f": 1, "texto": "Chegando, tamo", "de": 31.69, "ate": 32.33, "pos": 0.6}, {"f": 1, "texto": "chegando.", "de": 32.33, "ate": 32.83, "pos": 0.6}, {"f": 1, "texto": "Ela tá lá atrás?", "de": 47.01, "ate": 47.91, "pos": 0.6}, {"f": 1, "texto": "Cara, pior que agora", "de": 50.77, "ate": 51.53, "pos": 0.6}, {"f": 1, "texto": "que eu ouvi o pontinho, mano,", "pos": 0.76}, {"f": 1, "texto": "onde é que ela tava?", "pos": 0.76}, {"f": 2, "texto": "Carro merda", "de": 63.17, "ate": 63.75, "pos": 0.6}, {"f": 2, "texto": "do caralho, mano,", "de": 63.75, "ate": 64.49, "pos": 0.6}, {"f": 2, "texto": "na moral, pelo", "de": 64.57, "ate": 65.35, "pos": 0.6}, {"f": 2, "texto": "amor de Deus, velho!", "de": 66.84, "ate": 67.86, "pos": 0.6}, {"f": 2, "texto": "Olha!", "de": 70.41, "ate": 70.69, "pos": 0.6}]}