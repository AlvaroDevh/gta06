{"blocos": [{"f": 1, "texto": "Cês têm drogas, cara?", "pos": 0.6}, {"f": 1, "texto": "Eu vou balançar,", "pos": 0.6}, {"f": 1, "texto": "cara, calma.", "pos": 0.6}, {"f": 1, "texto": "Só que cês tavam...", "pos": 0.6}, {"f": 1, "texto": "Tô indo embora, irmão,", "pos": 0.6}, {"f": 1, "texto": "já meti o pé.", "pos": 0.6}, {"f": 1, "texto": "Já meti o pé, velho.", "pos": 0.6}, {"f": 1, "texto": "Tem um lugar aqui", "pos": 0.6}, {"f": 1, "texto": "marítimo também.", "pos": 0.6}, {"f": 1, "texto": "Caralho, o cara", "pos": 0.6}, {"f": 1, "texto": "ligou pra polícia", "pos": 0.6}, {"f": 1, "texto": "mesmo!", "pos": 0.6}, {"f": 1, "texto": "E ele ainda", "pos": 0.6}, {"f": 1, "texto": "denunciou meu carro!", "pos": 0.6}]}