{"blocos": [{"f": 1, "texto": "Calma, tem que fechar a mira, calma, pegou", "pos": 0.6}, {"f": 1, "texto": "na pedra, na pedra,", "de": 5.09, "ate": 6.47, "pos": 0.6}, {"f": 1, "texto": "calma,", "de": 6.51, "ate": 7.09, "pos": 0.6}, {"f": 1, "texto": "no seu tempo,", "de": 7.58, "ate": 8.42, "pos": 0.6}, {"f": 1, "texto": "legal, mais um,", "de": 8.91, "ate": 10.05, "pos": 0.6}, {"f": 1, "texto": "meu tempo, nice,", "de": 10.54, "ate": 11.72, "pos": 0.6}, {"f": 1, "texto": "mais um, opa!", "de": 12.3, "ate": 13.46, "pos": 0.6}, {"f": 3, "texto": "Tá jogando hoje! Meu", "de": 20.69, "ate": 21.95, "pos": 0.6}, {"f": 3, "texto": "Deus, eu não tô enxergando", "pos": 0.6}, {"f": 3, "texto": "os caras,", "de": 27.77, "ate": 28.15, "pos": 0.6}, {"f": 5, "texto": "cadê o cara?", "de": 37.13, "ate": 37.63, "pos": 0.6}, {"f": 2, "texto": "Merda... Mãe,", "de": 39.52, "ate": 40.86, "pos": 0.6}, {"f": 2, "texto": "tá viva?", "de": 42.81, "ate": 43.27, "pos": 0.6}, {"f": 2, "texto": "Eu esqueci de você!", "de": 43.39, "ate": 44.15, "pos": 0.6}, {"f": 4, "texto": "Nossa, eu esqueci", "de": 54.33, "ate": 55.13, "pos": 0.6}, {"f": 4, "texto": "da minha mãe, velho!", "de": 55.13, "ate": 55.9, "pos": 0.6}, {"f": 2, "texto": "Eu virei next stage", "de": 57.56, "ate": 58.8, "pos": 0.6}, {"f": 2, "texto": "e esqueci da", "de": 58.8, "ate": 59.56, "pos": 0.6}, {"f": 2, "texto": "minha mãe.", "de": 59.56, "ate": 60.0, "pos": 0.6}, {"f": 4, "texto": "Não se preocupe, ma.", "de": 60.37, "ate": 61.73, "pos": 0.6}]}