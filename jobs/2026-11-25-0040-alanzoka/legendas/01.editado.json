{"blocos": [{"f": 2, "texto": "É,", "de": 0.14, "ate": 0.8, "pos": 0.6}, {"f": 1, "texto": "dirigindo bem com o carrinho da", "pos": 0.46}, {"f": 1, "texto": "minha mãe, tá?", "de": 5.08, "ate": 5.62, "pos": 0.46}, {"f": 1, "texto": "Às vezes tudo", "de": 6.67, "ate": 7.25, "pos": 0.46}, {"f": 1, "texto": "que eu precisava era", "de": 7.25, "ate": 7.85, "pos": 0.46}, {"f": 1, "texto": "um hatchzinho mesmo.", "de": 7.85, "ate": 8.81, "pos": 0.46}, {"f": 1, "texto": "Eles", "de": 8.81, "ate": 9.37, "pos": 0.46}, {"f": 1, "texto": "entraram aqui dentro?", "pos": 0.46}, {"f": 1, "texto": "Procure-me no prédio.", "pos": 0.46}, {"f": 3, "texto": "Meu", "de": 18.33, "ate": 18.59, "pos": 0.46}, {"f": 4, "texto": "Deus,", "de": 28.63, "ate": 34.47, "pos": 0.46}, {"f": 1, "texto": "mano, mas caralho, é o Jason", "pos": 0.76}, {"f": 1, "texto": "que é sequestrado,", "de": 37.5, "ate": 38.36, "pos": 0.76}, {"f": 1, "texto": "é a Lucia,", "de": 38.46, "ate": 39.18, "pos": 0.76}, {"f": 1, "texto": "pelo amor de Deus,", "de": 39.22, "ate": 39.98, "pos": 0.76}, {"f": 1, "texto": "velho!", "de": 40.08, "ate": 40.52, "pos": 0.76}, {"f": 2, "texto": "Onde que eu me", "de": 41.95, "ate": 42.59, "pos": 0.76}, {"f": 2, "texto": "meti, velho?", "de": 42.59, "ate": 43.25, "pos": 0.76}, {"f": 2, "texto": "Cara, o cabelo dela", "de": 47.52, "ate": 48.34, "pos": 0.76}, {"f": 2, "texto": "grudou na parede,", "de": 48.34, "ate": 49.2, "pos": 0.76}, {"f": 2, "texto": "viu?", "de": 49.22, "ate": 49.32, "pos": 0.46}]}