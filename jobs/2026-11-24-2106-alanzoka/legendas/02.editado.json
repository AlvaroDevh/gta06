{"blocos": [{"f": 1, "texto": "Não é foda, mano?", "pos": 0.46}, {"f": 1, "texto": "Eu sou, cara, acho", "pos": 0.46}, {"f": 1, "texto": "que eu sou pior", "pos": 0.46}, {"f": 1, "texto": "no GPS do que em bater", "pos": 0.46}, {"f": 1, "texto": "o carro, mano!", "pos": 0.46}, {"f": 1, "texto": "Sempre erro o caminho, mano,", "pos": 0.46}, {"f": 1, "texto": "bater o carro não é sempre.", "pos": 0.46}, {"f": 1, "texto": "Nossa, eu quero", "pos": 0.46}, {"f": 1, "texto": "muito ir lá, velho!", "pos": 0.46}, {"f": 1, "texto": "Apareceu outra", "pos": 0.46}, {"f": 1, "texto": "missão, nice! Nossa,", "pos": 0.46}, {"f": 1, "texto": "chat, agora liberou", "pos": 0.46}, {"f": 1, "texto": "umas 15 missões! Acho que eu precisava só", "pos": 0.46}, {"f": 1, "texto": "fazer essas missões", "pos": 0.46}, {"f": 1, "texto": "do Dequan, mano,", "pos": 0.46}, {"f": 1, "texto": "Dequan pra liberar o resto.", "pos": 0.46}]}