{"blocos": [{"f": 1, "texto": "Cara, eu tô", "pos": 0.46}, {"f": 1, "texto": "com a Lucia tem", "pos": 0.46}, {"f": 1, "texto": "3 horas e, mano,", "pos": 0.46}, {"f": 1, "texto": "a gente não fica no amor.", "pos": 0.46}, {"f": 1, "texto": "Nosso amor não", "pos": 0.46}, {"f": 1, "texto": "aumenta, mano.", "pos": 0.46}, {"f": 1, "texto": "Acabou o amor desde", "pos": 0.46}, {"f": 1, "texto": "o Phantom, acabou, mano.", "pos": 0.46}, {"f": 1, "texto": "Tem que fazer coisa juntos.", "pos": 0.46}, {"f": 1, "texto": "Eu não tô fazendo", "pos": 0.46}, {"f": 1, "texto": "um monte de coisa juntos?", "pos": 0.46}, {"f": 1, "texto": "Tô com ela 3 horas, mano!", "pos": 0.46}, {"f": 1, "texto": "Acho que eu vou caçar, hein, chat.", "pos": 0.46}, {"f": 1, "texto": "Aqui eu não sei", "pos": 0.76}, {"f": 1, "texto": "o que fazer, mano.", "pos": 0.76}, {"f": 1, "texto": "Port Gellhorn.", "pos": 0.76}, {"f": 1, "texto": "Quero 10 mil.", "pos": 0.76}, {"f": 1, "texto": "Eu preciso mandar dinheiro pro meu filho.", "pos": 0.76}, {"f": 1, "texto": "Caralho, 14 mil", "pos": 0.76}, {"f": 1, "texto": "a 32 mil.", "pos": 0.76}, {"f": 1, "texto": "Manutenção de barcos, Brooks.", "pos": 0.76}, {"f": 1, "texto": "Fazer missão, não só", "pos": 0.46}, {"f": 1, "texto": "ficar andando com a Lucia.", "pos": 0.46}, {"f": 1, "texto": "Irmão, acabei de fazer", "pos": 0.46}, {"f": 1, "texto": "três missões com ela!", "pos": 0.46}]}